{
  "buildCommand": "next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://ai-market-prediction-production.up.railway.app",
    "NODE_ENV": "production",
    "NEXT_PUBLIC_API_VERSION": "v1",
    "NEXT_PUBLIC_ENABLE_SWR": "true",
    "NEXT_PUBLIC_SWR_INTERVAL": "5000"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}